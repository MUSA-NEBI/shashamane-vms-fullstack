# ============================================================
# Shashamane Vehicle Management System - Environment Variables
# Copy this file to server/.env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/svms?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_secret_string_min_64_chars
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:5173

# --- Cookie ---
COOKIE_SECRET=replace_with_another_long_random_secret

# --- Email (optional - for password reset emails) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_email_password
# EMAIL_FROM=noreply@svms.et
